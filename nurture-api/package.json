    "test:tasks": "node --test tests/tasks/tasks.unit.test.cjs tests/tasks/tasks.integration.test.cjs",
    "test:assistance": "node --test tests/assistance/assistance.unit.test.cjs tests/assistance/assistance.integration.test.cjs"
  },
