DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nurture
PORT=3000
# Use true for Azure PostgreSQL TLS; retain certificate verification.
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173

# Backend only. Used for text-embedding-3-small (1536 dimensions).
# No key is needed to run the isolated tests; they never call OpenAI.
OPENAI_API_KEY=

# Optional: the shared backend test suite REBUILDS this separate test database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nurture_test
